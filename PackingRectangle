#include<bits/stdc++.h>
using namespace std;
#define int long long
signed main(){
    int w , h , n; 
    cin>>w>>h>>n;

 int  s = 0 , e = max(w,h)*n;
   int ans = -1;
    while( s <= e){

        int  mid = s+ (e-s)/2;
        //cout<<"mid"<<mid<<endl;
        //long long  pack = (mid/w) * (mid/h) * 1LL;
        long long max_h = mid/h;
        long long max_w = mid/w;
        
        
        
        if(max_w>= (n+ max_h-1)/max_h ){
            ans = mid;
           // cout<<"ans"<<ans<<endl;
            e = mid-1;
           // cout<<"e"<<e<<endl;
        }else{
            s = mid+1;
           // cout<<"s"<<s<<endl;
        }
    }
    cout<<ans<<endl;
}
