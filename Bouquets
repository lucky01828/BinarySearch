#include<bits/stdc++.h>
using namespace std;
 bool check(vector<int>&arr, int m, int k, int mid){
         cout<<"mid"<<mid<<endl;
            int cnt = 0, i = 0, j =0;
            while(j < arr.size()){
                if(arr[j] > mid){
                    i = j+1;
                    
                }else if(j-i+1==k){
                    cnt++;
                    i = j+1;
                    cout<<"cnt"<<cnt<<endl;
                   
                }
                j++;
                if(cnt >= m) return true;
            }
            return false;
        }
int solve(vector<int> &arr, int m , int k ){
     
        int s = *min_element(arr.begin(), arr.end());
        int e = *max_element(arr.begin(), arr.end());
        if(m*k > arr.size()) return -1;
         

        int ans =-1;
        while(s<=e){
            int mid = s+(e-s)/2;
            if(check(arr,m,k,mid)){
                ans =mid;
             ///   s = mid+1;
             e = mid-1;
            }else{
                s=mid+1;
            }
        }
        return ans;
    }

int main(){
    int n,m,k; cin>>n>>m,k;
    vector<int> arr(n);
    for(int i =0;i<n;i++) cin>>arr[i];

    int ans = solve(arr,m,k);
    cout<<ans<<endl;
}
